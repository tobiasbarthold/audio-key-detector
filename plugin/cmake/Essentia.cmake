# Builds the small part of Essentia (https://github.com/MTG/essentia, AGPL-3.0) that the
# KeyExtractor chain needs, as a static library `essentia_key`. Essentia's own build system (waf)
# is not used; the sources are compiled unmodified from a pinned commit. FFT backend: Apple
# Accelerate (vDSP), so there are no external dependencies apart from the header-only Eigen
# (MPL-2.0) that Essentia's core headers include.

include(FetchContent)

set(ESSENTIA_COMMIT 33108c70929684ed14091dfb671a30264cf8bb84)   # master, 2026-10-22
FetchContent_Declare(essentia
    URL https://github.com/MTG/essentia/archive/${ESSENTIA_COMMIT}.tar.gz
    URL_HASH SHA256=ca3aefcdee066f15c5bf99ae3ccfd34cd7266cd723fdbf7a001267e68747b8d1
    SOURCE_SUBDIR no-cmake)       # populate only (Essentia has no CMakeLists.txt)
FetchContent_Declare(eigen
    URL https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz
    URL_HASH SHA256=8586084f71f9bde545ee7fa6d00288b264a2b7ac3607b974e54d13e7162c1c72
    SOURCE_SUBDIR no-cmake)       # header-only; do not configure Eigen's own project
FetchContent_MakeAvailable(essentia eigen)

set(ESS ${essentia_SOURCE_DIR}/src)

# Essentia core (framework: algorithms, parameters, pools, streaming scheduler).
file(GLOB ESSENTIA_CORE_SOURCES CONFIGURE_DEPENDS
    ${ESS}/essentia/*.cpp
    ${ESS}/essentia/scheduler/*.cpp
    ${ESS}/essentia/streaming/*.cpp
    ${ESS}/essentia/streaming/algorithms/*.cpp
    ${ESS}/essentia/utils/*.cpp)
# Parts that need libyaml / ffmpeg are not built (as in waf's --lightweight build).
list(FILTER ESSENTIA_CORE_SOURCES EXCLUDE REGEX "(yamlast|jsonconvert|audiocontext)\\.cpp$")

# Algorithms of KeyExtractor's chain plus what they create internally through the factory.
set(ESSENTIA_ALGO_SOURCES
    ${ESS}/algorithms/standard/framecutter.cpp
    ${ESS}/algorithms/standard/windowing.cpp
    ${ESS}/algorithms/standard/spectrum.cpp
    ${ESS}/algorithms/standard/ffta.cpp           # FFT via Accelerate
    ${ESS}/algorithms/complex/magnitude.cpp
    ${ESS}/algorithms/standard/peakdetection.cpp
    ${ESS}/algorithms/spectral/spectralpeaks.cpp
    ${ESS}/algorithms/spectral/spectralwhitening.cpp
    ${ESS}/algorithms/spectral/hpcp.cpp
    ${ESS}/algorithms/tonal/key.cpp)

# Essentia's version.h is generated by waf; write an equivalent one.
file(READ ${essentia_SOURCE_DIR}/VERSION ESSENTIA_VERSION_STRING)
string(STRIP "${ESSENTIA_VERSION_STRING}" ESSENTIA_VERSION_STRING)
set(ESSENTIA_GLUE_GEN ${CMAKE_CURRENT_BINARY_DIR}/essentia_glue)
file(WRITE ${ESSENTIA_GLUE_GEN}/version.h
    "#define ESSENTIA_VERSION \"${ESSENTIA_VERSION_STRING}\"\n#define ESSENTIA_GIT_SHA \"${ESSENTIA_COMMIT}\"\n")

add_library(essentia_key STATIC
    ${ESSENTIA_CORE_SOURCES}
    ${ESSENTIA_ALGO_SOURCES}
    ${CMAKE_CURRENT_LIST_DIR}/../essentia_glue/essentia_algorithms_reg.cpp)

target_include_directories(essentia_key SYSTEM PUBLIC
    ${ESSENTIA_GLUE_GEN}
    ${ESS}
    ${ESS}/essentia
    ${ESS}/essentia/scheduler
    ${ESS}/essentia/streaming
    ${ESS}/essentia/streaming/algorithms
    ${ESS}/essentia/utils
    ${ESS}/3rdparty
    ${eigen_SOURCE_DIR})
target_include_directories(essentia_key PRIVATE
    ${ESS}/algorithms/standard
    ${ESS}/algorithms/spectral
    ${ESS}/algorithms/tonal
    ${ESS}/algorithms/complex)
target_compile_definitions(essentia_key PUBLIC
    EIGEN_MPL2_ONLY
    EIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS)
target_compile_features(essentia_key PUBLIC cxx_std_17)
target_compile_options(essentia_key PRIVATE -w)       # third-party code: no warnings
set_target_properties(essentia_key PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_link_libraries(essentia_key PUBLIC "-framework Accelerate")
